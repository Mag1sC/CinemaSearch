<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_app_background"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_posters_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_navigation_bars"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_top_bar"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.MdcTypographyStyles.Headline5"
        app:titleTextColor="@color/color_accent" />

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/bottom_bar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@color/color_navigation_bars"
        app:itemIconTint="@color/color_accent"
        app:itemTextColor="@color/color_accent"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:menu="@menu/menu_bottom_bar"
        app:menuGravity="center" />

    <androidx.cardview.widget.CardView
        android:id="@+id/posters_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/text_view_poster_source"
        app:layout_constraintEnd_toStartOf="@id/guideline_posters_bar"
        app:layout_constraintStart_toEndOf="@id/bottom_bar"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintVertical_chainStyle="packed">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="4">

            <ImageView
                android:id="@+id/image_view_behemoth_poster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/behemoth_poster_description"
                android:scaleType="centerCrop"
                android:src="@drawable/poster_behemoth" />

            <ImageView
                android:id="@+id/image_view_dune_poster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/dune3_poster_description"
                android:scaleType="centerCrop"
                android:src="@drawable/poster_dune3" />

            <ImageView
                android:id="@+id/image_view_jumanji_poster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/jumanji_poster_description"
                android:scaleType="centerCrop"
                android:src="@drawable/poster_jumanji" />

            <ImageView
                android:id="@+id/image_view_river_poster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/river_poster_description"
                android:scaleType="centerCrop"
                android:src="@drawable/poster_river" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_view_poster_source"
        style="@style/TextAppearance.MdcTypographyStyles.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:autoLink="web"
        android:gravity="center"
        android:linksClickable="true"
        android:text="@string/info_posters_source"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/posters_bar"
        app:layout_constraintStart_toStartOf="@id/posters_bar"
        app:layout_constraintTop_toBottomOf="@id/posters_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>